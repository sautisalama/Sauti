# Sample .env
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=localhost:3000

STREAM_CHAT_SECRET=
NEXT_PUBLIC_STREAM_KEY=

#openweathermap
NEXT_PUBLIC_OPENWEATHER_API_KEY=

#mailtrap for sending emails after abuse reports
MAILTRAP_TOKEN=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

#google calendar integration (see docs/GOOGLE_CALENDAR_INTEGRATION.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

NEXT_PUBLIC_LOCATIONIQ_API_KEY=

#Openrouter
OPENROUTER_API_KEY=
# Application-level encryption for stored secrets (calendar tokens, later report PII).
# Generate with: openssl rand -base64 32   (keep a copy in your secret manager; losing it = unreadable data)
DATA_ENCRYPTION_KEY=
# Optional, for rotation: the previous key (decrypt-only)
DATA_ENCRYPTION_KEY_PREVIOUS=

# Secret for Vercel cron routes (sent as Authorization: Bearer ...)
CRON_SECRET=
# Optional: comma-separated override of who receives urgent case escalations
ESCALATION_EMAILS=
